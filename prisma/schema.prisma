// Prisma schema for fantasy-mcp.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7: the connection URL lives in prisma.config.ts, not here.
datasource db {
  provider = "postgresql"
}

// A registered person/team. Identity is anchored on the Sleeper user_id
// (permanent); username/displayName are mutable Sleeper metadata. The issued
// API key is stored only as a hash and looked up per authenticated MCP request.
model User {
  id              String   @id @default(cuid())
  firstName       String
  lastName        String
  email           String   @unique
  sleeperUserId   String   @unique
  sleeperUsername String
  displayName     String
  apiKeyHash      String   @unique
  apiKeyPrefix    String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
