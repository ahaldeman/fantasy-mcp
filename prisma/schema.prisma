// Prisma schema for fantasy-mcp.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7: the connection URL lives in prisma.config.ts, not here.
datasource db {
  provider = "postgresql"
}

// A registered person/team. Identity is anchored on the Sleeper user_id
// (permanent); username/displayName are mutable Sleeper metadata. Auth uses a
// self-contained signed JWT, so no credential is stored here — this row is the
// account record and the source of uniqueness (email, sleeperUserId).
model User {
  id              String   @id @default(cuid())
  firstName       String
  lastName        String
  email           String   @unique
  sleeperUserId   String   @unique
  sleeperUsername String
  displayName     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
