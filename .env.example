DATABASE_URL="postgresql://fantasy:fantasy@localhost:5432/fantasy?schema=public"
PORT=3000
HOST=127.0.0.1
LOG_LEVEL=info
SLEEPER_API_BASE_URL=https://api.sleeper.app/v1
# Signing secret for auth tokens (>=32 chars). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Rotating this value invalidates every issued token.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
# Daily players-sync schedule (cron), its timezone, and snapshot retention.
PLAYERS_SYNC_CRON=0 9 * * *
PLAYERS_SYNC_TZ=America/New_York
PLAYERS_SNAPSHOT_RETENTION_DAYS=14
